# chain data
GOLDRUSH_API_KEY=

# balance failover only, used when GoldRush does not answer. Alchemy has no
# approvals endpoint and no portfolio series, so it cannot stand in for the
# whole provider — and a report served from it is deliberately not scored.
ALCHEMY_API_KEY=

# the written diagnosis — one call per report, Anthropic Messages API
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-6

# the chat layer — high volume, OpenAI-compatible, decentralized inference
GONKA_API_KEY=
GONKA_BASE_URL=
# Kimi is the only model on this broker that emits tool calls
GONKA_MODEL=moonshotai/Kimi-K2.6

# How long the chat waits for the decentralized node to say something before it
# also asks the fallback and races them. Raise it to favour Gonka, lower it to
# favour a predictable answer time. Default 4500.
CHAT_HEDGE_MS=4500
